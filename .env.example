# Copy to .env and fill in before running: docker compose up --build

POSTGRES_PASSWORD=change-me-strong-db-password

# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-secret
IP_HASH_SALT=change-me-to-a-random-salt

# Public URL of the frontend (used for CORS and cookie domain)
CORS_ORIGIN=http://localhost:8080
VITE_BACKEND_URL=http://localhost:3000

# Optional when using a custom domain with subdomains
# COOKIE_DOMAIN=.yourdomain.com
