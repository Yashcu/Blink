NODE_ENV=development
PORT=3000

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:your_password@localhost:5432/shorty

# Redis connection string
REDIS_URL=redis://localhost:6379

# Auth — use a random 32+ character string in production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN_SECONDS=900
SESSION_EXPIRES_IN_SECONDS=604800

# Frontend origin (must match where the SPA is served)
CORS_ORIGIN=http://localhost:5173

# Optional: set when frontend and API share a parent domain (e.g. .yourdomain.com)
# COOKIE_DOMAIN=.yourdomain.com

# Salt for hashing visitor IPs in analytics — use a unique random string in production
IP_HASH_SALT=change-me-to-a-random-salt
